# Required only if you want the proxy to inject your AIHubMix key on the server.
# When this is set, clients should use PROXY_API_KEY instead of the real AIHubMix key.
UPSTREAM_API_KEY=sk-your-aihubmix-key

# Optional but recommended when UPSTREAM_API_KEY is set.
PROXY_API_KEY=replace-with-a-random-client-password

# AIHubMix primary domain. If needed, replace with https://api.inferera.com.
UPSTREAM_BASE_URL=https://aihubmix.com

PORT=7860
REQUEST_TIMEOUT_SECONDS=600
ALLOWED_ORIGINS=*
